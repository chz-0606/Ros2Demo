<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="qqbot">
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/base.urdf.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/sensor/imu.urdf.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/sensor/camera.urdf.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/sensor/laser.urdf.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/actuator/wheel.urdf.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/actuator/caster.urdf.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/plugins/gazebo_control_plugin.xacro"/>
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/plugins/gazebo_sensor_plugin.xacro"/>

    <!-- 机器人身体 -->
    <xacro:base_xacro length="0.12" radius="0.1"/>

    <!-- 机器人IMU -->
    <xacro:imu_xacro xyz="0 0 0.02"/>

    <!-- 机器人摄像头 -->
    <xacro:camera_xacro xyz="0.10 0 0.075"/>

    <!-- 机器人雷达 -->
    <xacro:laser_xacro xyz="0 0 0.10"/>

    <!-- 机器人轮子 -->
    <xacro:wheel_xacro wheel_name= "wheel_left" xyz="0 0.10 -0.06"/>
    <xacro:wheel_xacro wheel_name= "wheel_right" xyz="0 -0.10 -0.06"/>

    <!-- 机器人万向轮 -->
    <xacro:caster_xacro caster_name= "caster_front" xyz="0.08 0.0 -0.076"/>
    <xacro:caster_xacro caster_name= "caster_back" xyz="-0.08 0.0 -0.076"/>

    <!-- Gazebo插件 -->
    <xacro:gazebo_control_plugin/>
    <xacro:gazebo_sensor_plugin/>
</robot>