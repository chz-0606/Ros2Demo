<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find fishbot_description)/urdf/qqbot/common_inertial.xacro"/>

    <xacro:macro name="wheel_xacro" params="wheel_name xyz">
        <!-- 机器人的WHEEL部件 -->
        <link name="${wheel_name}_link">
            <visual>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0 0.8"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.57079 0 0"/>
                <geometry>
                    <cylinder radius="0.032" length="0.04"/>
                </geometry>
                <material name="yellow">
                    <color rgba="1.0 1.0 0 0.8"/>
                </material>
            </collision>

            <xacro:cylinder_inertia m="0.05" r="0.032" h="0.04"/>
        </link>
        <!-- 机器人的关节 -->
        <joint name="${wheel_name}_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${wheel_name}_link"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
            <axis xyz="0.0 1.0 0.0"/>
        </joint>
        <gazebo reference="${wheel_name}_link">
            <material>Gazebo/Yellow</material>
            <mu1>20.0</mu1>
            <mu2>20.0</mu2>
            <kp>10000000000.0</kp>
            <kd>1.0</kd>
        </gazebo>
    </xacro:macro>

    </robot>
