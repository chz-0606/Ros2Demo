<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="first_robot">
    <xacro:macro name="base_link" params="length radius">
        <!-- 机器人的身体部分 -->
        <link name="base_link">
        <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 -->
                    <cylinder radius="${radius}" length="${length}"/>
                </geometry>
                <!-- 材质颜色 -->
                <material name="blue">
                    <color rgba="1 1 0.5 0.5"/>
                </material>
            </visual>   
        </link>
    </xacro:macro>

    <xacro:macro name="imu_link" params="imu_name size xyz">
        <!-- 机器人的IMU部件 -->
        <link name="${imu_name}">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="${size} ${size} ${size}"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.5"/>
                </material>
            </visual>
        </link>
        <!-- 机器人的关节 -->
        <joint name="${imu_name}_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${imu_name}"/>
            <origin xyz="${xyz}" rpy="0 0 0"/>
        </joint>
    </xacro:macro>

    <xacro:base_link length="0.12" radius="0.1"/>
    <xacro:imu_link imu_name="imu_up" size="0.02" xyz="0 0 0.03"/>
    <xacro:imu_link imu_name="imu_down" size="0.02" xyz="0 0 -0.03"/>
    </robot>
