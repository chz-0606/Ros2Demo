<?xml version="1.0"?>
<robot name="first_robot">
<!-- 机器人的身体部分 -->
        <link name="base_link">
        <!-- 部件的外观描述 -->
            <visual>
                <!-- 沿着自己几何中心的偏移和旋转量 -->
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <!-- 几何形状 -->
                <geometry>
                    <!-- 圆柱体 -->
                    <cylinder radius="0.1" length="0.12"/>
                </geometry>
                <!-- 材质颜色 -->
                <material name="blue">
                    <color rgba="1 1 0.5 0.5"/>
                </material>
            </visual>   
        </link>
        <!-- 机器人的IMU部件 -->
        <link name="imu_link">
            <visual>
                <origin xyz="0 0 0" rpy="0 0 0"/>
                <geometry>
                    <box size="0.02 0.02 0.02"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 0.5"/>
                </material>
            </visual>
        </link>
        <!-- 机器人的关节 -->
        <joint name="imu_joint" type="fixed">
            <parent link="base_link"/>
            <child link="imu_link"/>
            <origin xyz="0 0 0.03" rpy="0 0 0"/>
        </joint>
    </robot>
